# General
ENVIRONMENT=production
LOG_LEVEL=info

# Backend Service
BACKEND_PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Frontend Service
FRONTEND_PORT=5173
# Browser-accessible backend API URL
# For local Docker: http://localhost:8000
# For production cloud deployment: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000
