# ==============================================================
# Backend Configuration (.env)
# ==============================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Logging Level (debug | info | warning | error)
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated origins or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional custom path for dataset CSV (defaults to backend/data/cleaned_crop_recommendation.csv)
# DATASET_PATH=data/cleaned_crop_recommendation.csv
